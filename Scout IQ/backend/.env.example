# Replace placeholders locally. Do not commit .env or real credentials.
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:8000/scoutiq
TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:8000/scoutiq_test
# Generate a new random secret for each deployment; leave no placeholder in use.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ENFORCE_HTTPS=false
